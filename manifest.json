{
  "manifest_version": 3,
  "name": "Kelmar Vehicle Scanner",
  "version": "23.0.8",
  "description": "Scan Facebook Marketplace vehicle listings and securely send results to a private sourcing dashboard.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://facebook.com/*",
    "https://sourcing.kelmarvehiclesltd.co.uk/*",
    "https://facebook-web-filter.vercel.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/marketplace*",
        "https://www.facebook.com/marketplace/*",
        "https://facebook.com/marketplace*",
        "https://facebook.com/marketplace/*"
      ],
      "js": [
        "category-detector.js",
        "listing-category-pipeline.js",
        "mileage-utils.js",
        "scanner-lifecycle.js",
        "scanner-diagnostics.js",
        "scanner-runtime.js",
        "scanner-storage.js",
        "vehicle-identity.js",
        "listing-details-extractor.js",
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Kelmar Vehicle Scanner",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "homepage_url": "https://sourcing.kelmarvehiclesltd.co.uk/support",
  "key": ""
}
